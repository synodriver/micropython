# Called after project(), when the SDK's bt target and final sdkconfig exist.
if(NOT ((IDF_VERSION_MAJOR EQUAL 5 AND IDF_VERSION_MINOR EQUAL 5 AND IDF_VERSION_PATCH GREATER_EQUAL 3)
    OR (IDF_VERSION_MAJOR EQUAL 6 AND IDF_VERSION_MINOR EQUAL 1)))
    message(FATAL_ERROR "BLE Mesh coexistence requires ESP-IDF 5.5.x (>=5.5.3) or 6.1.x")
endif()
if(NOT IDF_TARGET MATCHES "^(esp32c3|esp32c5|esp32c6|esp32h2|esp32s3)$")
    message(FATAL_ERROR "BLE Mesh coexistence targets ESP32-C3/C5/C6/H2/S3; ESP32-C2 lacks SDK Mesh support")
endif()
if(IDF_TARGET STREQUAL "esp32c5" AND IDF_VERSION_MAJOR EQUAL 5 AND IDF_VERSION_PATCH LESS 5)
    message(FATAL_ERROR "ESP32-C5 Mesh requires ESP-IDF 5.5.5 or newer 5.5.x, or 6.1.x")
endif()
foreach(required SOC_BLE_MESH_SUPPORTED BLE_MESH BT_NIMBLE_ENABLED BT_NIMBLE_EXT_ADV BT_NIMBLE_EXT_SCAN
    BLE_MESH_NODE BLE_MESH_PB_ADV BLE_MESH_USE_BLE_50 BLE_MESH_DEINIT BLE_MESH_SETTINGS BLE_MESH_HEALTH_SRV)
    if(NOT CONFIG_${required})
        message(FATAL_ERROR "BLE Mesh coexistence requires CONFIG_${required}")
    endif()
endforeach()
foreach(unsupported BT_NIMBLE_MESH BLE_MESH_PB_GATT BLE_MESH_PROXY BLE_MESH_PROVISIONER
    BLE_MESH_GATT_PROXY_SERVER BLE_MESH_GATT_PROXY_CLIENT BLE_MESH_V11_SUPPORT
    BLE_MESH_EXT_ADV BLE_MESH_LONG_PACKET BLE_MESH_SUPPORT_MULTI_ADV
    BLE_MESH_SUPPORT_BLE_ADV BLE_MESH_LOW_POWER BLE_MESH_FRIEND BLE_MESH_RELAY
    BLE_MESH_USE_DUPLICATE_SCAN BLE_MESH_FAST_PROV)
    if(CONFIG_${unsupported})
        message(FATAL_ERROR "First-stage BLE Mesh coexistence does not support CONFIG_${unsupported}")
    endif()
endforeach()
if(NOT CONFIG_BLE_MESH_ADV_INST_ID EQUAL 3 OR NOT CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES EQUAL 4)
    message(FATAL_ERROR "BLE Mesh requires role 3 mapped to physical instance 4 and four extra advertising instances")
endif()
# C3/S3 share ten controller activities between advertising, scanning,
# connections and periodic sync. Other supported controllers take their
# effective advertising capacity from MYNEWT_VAL(BLE_MULTI_ADV_INSTANCES)
# when NimBLE is enabled, not CONFIG_BT_LE_MAX_EXT_ADV_INSTANCES.
if(IDF_TARGET STREQUAL "esp32c3" OR IDF_TARGET STREQUAL "esp32s3")
    if(NOT CONFIG_BT_CTRL_BLE_MAX_ACT EQUAL 10)
        message(FATAL_ERROR "BLE Mesh on C3/S3 requires CONFIG_BT_CTRL_BLE_MAX_ACT=10")
    endif()
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(mesh_dir ${CMAKE_CURRENT_LIST_DIR})
set(mesh_input "$ENV{IDF_PATH}/components/bt/esp_ble_mesh/core/nimble_host/adapter.c")
set(mesh_output "${CMAKE_BINARY_DIR}/blemesh/adapter.c")
set(mesh_adv_input "$ENV{IDF_PATH}/components/bt/esp_ble_mesh/core/adv.c")
set(mesh_adv_output "${CMAKE_BINARY_DIR}/blemesh/adv.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    ${mesh_input} ${mesh_adv_input} ${mesh_dir}/make_adapter.py)
execute_process(COMMAND ${Python3_EXECUTABLE} ${mesh_dir}/make_adapter.py
    --input ${mesh_input} --output ${mesh_output}
    --adv-input ${mesh_adv_input} --adv-output ${mesh_adv_output} RESULT_VARIABLE mesh_result)
if(NOT mesh_result EQUAL 0)
    message(FATAL_ERROR "Failed to generate ESP-BLE-MESH coexistence adapter")
endif()
idf_component_get_property(mesh_bt_target bt COMPONENT_LIB)
get_target_property(mesh_bt_sources ${mesh_bt_target} SOURCES)
set(mesh_replaced 0)
set(mesh_adv_replaced 0)
set(mesh_sources)
foreach(source IN LISTS mesh_bt_sources)
    if(source MATCHES "(^|/)esp_ble_mesh/core/nimble_host/adapter\\.c$")
        list(APPEND mesh_sources ${mesh_output})
        math(EXPR mesh_replaced "${mesh_replaced} + 1")
    elseif(source MATCHES "(^|/)esp_ble_mesh/core/adv\\.c$")
        list(APPEND mesh_sources ${mesh_adv_output})
        math(EXPR mesh_adv_replaced "${mesh_adv_replaced} + 1")
    else()
        list(APPEND mesh_sources ${source})
    endif()
endforeach()
if(NOT mesh_replaced EQUAL 1)
    message(FATAL_ERROR "ESP-IDF bt source layout changed: expected one Mesh NimBLE adapter")
endif()
if(NOT mesh_adv_replaced EQUAL 1)
    message(FATAL_ERROR "ESP-IDF bt source layout changed: expected one Mesh advertising worker")
endif()
set_property(TARGET ${mesh_bt_target} PROPERTY SOURCES ${mesh_sources})
target_include_directories(${mesh_bt_target} PRIVATE ${mesh_dir})
