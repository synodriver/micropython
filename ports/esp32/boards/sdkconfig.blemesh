# Five physical instances: application 0..3, private Mesh instance 4.
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=4
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_EXPERIMENTAL=y
CONFIG_BLE_MESH_USE_BLE_50=y
CONFIG_BLE_MESH_ADV_INST_ID=3
# SDK role ID is limited to 0..3; the generated adapter maps it to physical 4.
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_DEINIT=y
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_STORE_TIMEOUT=0
CONFIG_BLE_MESH_SEQ_STORE_RATE=100
CONFIG_BLE_MESH_RPL_STORE_TIMEOUT=0
CONFIG_BLE_MESH_HEALTH_SRV=y
# CONFIG_BT_NIMBLE_MESH is not set
# CONFIG_BLE_MESH_V11_SUPPORT is not set
# CONFIG_BLE_MESH_PB_GATT is not set
# CONFIG_BLE_MESH_PROXY is not set
# CONFIG_BLE_MESH_USE_DUPLICATE_SCAN is not set
# CONFIG_BLE_MESH_FAST_PROV is not set
# CONFIG_BLE_MESH_GATT_PROXY_SERVER is not set
# CONFIG_BLE_MESH_GATT_PROXY_CLIENT is not set
# CONFIG_BLE_MESH_PROVISIONER is not set
# CONFIG_BLE_MESH_RELAY is not set
# CONFIG_BLE_MESH_LOW_POWER is not set
# CONFIG_BLE_MESH_FRIEND is not set
# CONFIG_BLE_MESH_EXT_ADV is not set
# CONFIG_BLE_MESH_LONG_PACKET is not set
# CONFIG_BLE_MESH_SUPPORT_MULTI_ADV is not set
# CONFIG_BLE_MESH_SUPPORT_BLE_ADV is not set
